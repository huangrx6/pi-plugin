{
  "name": "huangrx6-pi-plugin",
  "version": "0.1.0",
  "description": "Independent Pi extensions for browser test specifications, automatic compaction, skills, approval modes, usage status, policies, tasks, notifications, and terminal layout.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:all": "bash scripts/baseline.sh",
    "config:validate": "node scripts/check-config.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "monorepo"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-skill-inject",
      "./extensions/pi-mode-switcher",
      "./extensions/pi-quota-status",
      "./extensions/pi-policy-engine",
      "./extensions/pi-footer-composer",
      "./extensions/pi-todo",
      "./extensions/pi-notify",
      "./extensions/pi-auto-compact",
      "./extensions/pi-browser-test"
    ]
  },
  "files": [
    "extensions/",
    "bin/",
    "docs/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ]
}
