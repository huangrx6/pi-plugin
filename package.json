{
  "name": "huangrx6-pi-plugin",
  "version": "0.1.0",
  "description": "Monorepo of independent pi extensions, including context QoS, skills, modes, status, policy, footer, todo, and notifications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "monorepo"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-skill-inject",
      "./extensions/pi-mode-switcher",
      "./extensions/pi-quota-status",
      "./extensions/pi-policy-engine",
      "./extensions/pi-footer-composer",
      "./extensions/pi-todo",
      "./extensions/pi-notify",
      "./extensions/pi-context-qos"
    ]
  },
  "files": [
    "extensions/",
    "bin/",
    "README.md",
    "LICENSE"
  ]
}
