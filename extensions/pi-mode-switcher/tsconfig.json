{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "../../extensions/_shared/**/*.d.ts",
    "**/*.ts",
    "**/*.d.ts"
  ]
}
