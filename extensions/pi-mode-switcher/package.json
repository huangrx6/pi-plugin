{
  "name": "pi-mode-switcher",
  "version": "0.2.1",
  "description": "Three-mode Pi approval control with native confirmation dialogs and a terminal-safe independent /mode interface.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "display.ts",
    "globals.d.ts",
    "tsconfig.json",
    "tests/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "check": "tsc -p . --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
