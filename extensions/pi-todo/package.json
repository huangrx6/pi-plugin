{
  "name": "pi-todo",
  "version": "0.7.3",
  "description": "Workspace-scoped durable tasks for Pi: task-first /todos list, contextual actions, task history, and an optional compact editor status strip.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc -p . --noEmit",
    "test": "tsx --test *.test.ts"
  }
}
