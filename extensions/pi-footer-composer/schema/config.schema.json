{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pi Footer Composer v5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 5
    },
    "mode": {
      "enum": [
        "custom",
        "native"
      ]
    },
    "icons": {
      "enum": [
        "unicode",
        "ascii"
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "textColor": {
          "enum": [
            "muted",
            "dim",
            "text"
          ]
        },
        "borderColor": {
          "enum": [
            "muted",
            "dim",
            "text"
          ]
        },
        "gap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "panelWidth": {
          "type": "integer",
          "minimum": 28,
          "maximum": 100
        }
      }
    },
    "more": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeUnmapped": {
          "type": "boolean"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "status"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "hidden": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
