{
  "name": "pi-footer-composer",
  "version": "4.2.0",
  "description": "A collapsible, clickable Pi footer with a one-line summary and configurable table or information-band details.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc -p . --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "ajv": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "disclosure.ts",
    "config.ts",
    "layout.ts",
    "compose.ts",
    "data.ts",
    "settings.ts",
    "table.ts",
    "bands.ts",
    "wrapping.ts",
    "globals.d.ts",
    "tsconfig.json",
    "tests/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONFIG.md",
    "schema/",
    "examples/"
  ]
}
