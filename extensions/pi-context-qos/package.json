{
  "name": "pi-context-qos",
  "version": "0.1.3",
  "description": "Non-destructive, task-aware, recoverable working-context runtime with SQLite/FTS5 metadata and content-addressed zstd cold storage.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-management",
    "sqlite",
    "zstd"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc -p . --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "files": [
    "index.ts",
    "src/",
    "globals.d.ts",
    "tsconfig.json",
    "tsconfig.runtime.json",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
