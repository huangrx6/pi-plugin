{
  "name": "pi-quota-status",
  "version": "0.1.0",
  "description": "Show AI subscription quota (OpenCode Go / Zhipu GLM / MiniMax Token Plan / Kimi Code / DeepSeek / OpenRouter) in the pi footer, auto-switching on model change.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc -p . --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "adapters.ts",
    "constants.ts",
    "format.ts",
    "state.ts",
    "types.ts",
    "globals.d.ts",
    "README.md",
    "LICENSE"
  ]
}
