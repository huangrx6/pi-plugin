{
  "name": "pi-throughput",
  "version": "0.10.0",
  "description": "Session model/tool time, first-content latency, and measured end-to-end or non-reasoning output throughput.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc -p . --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "samples.ts",
    "config.ts",
    "constants.ts",
    "format.ts",
    "session.ts",
    "toolclock.ts",
    "stats.ts",
    "tracker.ts",
    "types.ts",
    "ui.ts",
    "config/defaults.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
