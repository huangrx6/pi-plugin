{
  "name": "pi-notify",
  "version": "0.3.0",
  "description": "Independent notifications: OSC protocols, multiplexer routing, and a system fallback for terminals without one.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "notification",
    "desktop-notification",
    "osc",
    "terminal"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc -p . --noEmit",
    "test": "tsx --test *.test.ts"
  },
  "files": [
    "index.ts",
    "format.ts",
    "notifier.ts",
    "terminal.ts",
    "tsconfig.json",
    "globals.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
