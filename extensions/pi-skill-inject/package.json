{
  "name": "pi-skill-inject",
  "version": "0.1.1",
  "description": "Inline /skill loading for pi: type /skill-name in a prompt to inject that skill's content for the current turn.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "globals.d.ts",
    "tsconfig.json",
    "tests/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc -p . --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}