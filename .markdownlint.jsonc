{
  // markdownlint configuration for the pi-plugin monorepo.
  //
  // MD013 (line-length): disabled repo-wide. This is a primarily CJK
  // repository: hard-wrapping Chinese prose at 80 columns shatters
  // readability, and tables / ASCII state diagrams legitimately exceed it.
  // This replaces the per-file `<!-- markdownlint-disable MD013 -->` inline
  // comments that previously lived in some READMEs (single source of truth:
  // here).
  //
  // MD024 (no-duplicate-heading): siblings_only. CHANGELOG files repeat
  // "### Files" / "### Tests" under EVERY release's `## <version>` parent
  // — cross-parent repetition is the changelog idiom, not drift. Only
  // same-parent duplicates remain errors.
  //
  // MD060 (table-column-style): "padded" because every README in this repo
  // uses the spaced form ("| h1 | h2 |") rather than the default "compact"
  // form ("|h1|h2|").
  //
  // Everything else stays at markdownlint defaults and is enforced by CI.
  // Ignoring paths: markdownlint-cli2's `ignoreFiles` globs do not match
  // dot-directories like `.legacy/`, so exclusions are done on the command
  // line with the documented `#` negation syntax (see ci.yml):
  //   markdownlint-cli2 "**/*.md" "#**/.legacy/**" "#**/node_modules/**"
  "MD013": false,
  "MD024": {
    "siblings_only": true
  },
  "MD060": {
    "style": "padded"
  }
}
